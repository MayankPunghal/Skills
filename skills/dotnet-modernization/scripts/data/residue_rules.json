   "playbook": "aws-managed-services",
   "kb": [],
   "group": [
    "port"
   ]
  },
  {
   "id": "SVC-ENYIM",
   "where": "code",
   "level": "warn",
   "pattern": "\\bMemcachedClient\\b|using\\s+Enyim\\.Caching",
   "message": "Enyim Memcached client (.NET Framework build): EnyimMemcachedCore / ElastiCache",
   "playbook": "aws-managed-services",
   "kb": [],
   "group": [
    "port"
   ]
  },
  {
   "id": "SVC-MONGO-LEGACY",
   "where": "code",
   "level": "block",
   "pattern": "\\bMongoServer\\b|\\bMongoCollection<|WriteConcern\\.Unacknowledged",
   "message": "MongoDB driver 1.x legacy API (current driver, DocumentDB, or remove)",
   "playbook": "aws-managed-services",
   "kb": [],
   "group": [
    "port"
   ]
  },
  {
   "id": "SVC-HOSTED-LOG",
   "where": "code",
   "level": "warn",
   "pattern": "\\bLoggly\\w*\\b|\\bSplunk\\w*\\b|\\bSumoLogic\\w*\\b",
   "message": "Hosted log service in code (CloudWatch Logs via stdout)",
   "playbook": "aws-managed-services",
   "kb": [
    "12"
   ],
   "group": [
    "port"
   ]
  },
  {
   "id": "DB-SQLCLIENT",
   "where": "code",
   "level": "block",
   "when": "postgresql",
   "pattern": "\\bSqlConnection\\b|\\bSqlCommand\\b|\\bSqlDataAdapter\\b|System\\.Data\\.SqlClient|Microsoft\\.Data\\.SqlClient",
   "message": "SQL Server client in code with a PostgreSQL-only target (Npgsql)",
   "playbook": "raw-sql-and-data-access",
   "kb": [
    "07"
   ],
   "group": [
    "port"
   ]
  },
  {
   "id": "DB-SYSTEM-SQLCLIENT",
   "where": "code",
   "level": "block",
   "pattern": "using\\s+System\\.Data\\.SqlClient\\b",
   "message": "System.Data.SqlClient is deprecated (Microsoft.Data.SqlClient for the SQL Server path)",
   "playbook": "raw-sql-and-data-access",
   "kb": [
    "07"
   ],
   "group": [
    "port"
   ]
  },
  {
   "id": "DB-SQLERROR-NUMBER",
   "where": "code",
   "level": "warn",
   "when": "postgresql|dual",
   "pattern": "\\bSqlException\\b[^;\\n]*\\.Number\\b|\\.Number\\s*==\\s*(1205|2627|2601|547|-2)\\b",
   "message": "SQL Server error numbers (map PostgreSQL SQLSTATE codes too)",
   "playbook": "raw-sql-and-data-access",
   "kb": [
    "07"
   ],
   "group": [
    "port"
   ]
  },
  {
   "id": "DB-XMLREADER",
   "where": "code",
   "level": "warn",
   "when": "postgresql|dual",
   "pattern": "\\bExecuteXmlReader\\b",
   "message": "FOR XML result read through ExecuteXmlReader (no PostgreSQL equivalent)",
   "playbook": "raw-sql-and-data-access",
   "kb": [],
   "group": [
    "port"
   ]
  },
  {
   "id": "SQL-TSQL-IN-STRING",
   "where": "sql",
   "level": "block",
   "when": "postgresql|dual",
   "pattern": "\\bTOP\\s*\\(?\\d|\\bGETDATE\\s*\\(|\\bISNULL\\s*\\(|\\bWITH\\s*\\(\\s*NOLOCK|@@IDENTITY|\\bSCOPE_IDENTITY\\s*\\(|\\[dbo\\]\\.|\\bNEWID\\s*\\(|\\bDATEADD\\s*\\(|\\bCONVERT\\s*\\(\\s*(varchar|nvarchar|datetime|int)\\b|\\bLEN\\s*\\(|\\bFOR\\s+XML\\b|\\bOUTPUT\\s+INSERTED\\b",
   "message": "T-SQL-only syntax in a SQL string (PostgreSQL rejects it; move to the dialect resource for the PostgreSQL path)",
   "playbook": "raw-sql-and-data-access",
   "kb": [
    "07"
   ],
   "group": [
    "port"
   ]
  },
  {
   "id": "SQL-CROSS-DB",
   "where": "sql",
   "level": "block",
   "when": "postgresql|dual",
   "pattern": "\\b\\w+\\.dbo\\.\\w+|\\{\\w*\\}\\.dbo\\.|^\\$?@?\\\"\\s*\\.dbo\\.\\w+",
   "message": "Three-part (cross-database) name in SQL, written out or built as <db> + \".dbo.table\"",
   "playbook": "raw-sql-and-data-access",
   "kb": [],
   "group": [
    "port"
   ]
  },
  {
   "id": "SQL-CONCAT-VALUE",
   "where": "sql",
   "level": "warn",
   "pattern": "(=|<>|<|>|\\bIN\\s*\\(|\\bLIKE)\\s*'?\\s*\\\"\\s*\\+\\s*[\\w(]",
   "message": "Value concatenated into SQL text (parameterise)",
   "playbook": "raw-sql-and-data-access",
   "kb": [
    "07"
   ],
   "scope": "line",
   "group": [
    "port"
   ]
  }
 ]
}