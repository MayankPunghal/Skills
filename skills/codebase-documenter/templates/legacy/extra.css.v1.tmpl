:root, [data-md-color-scheme="default"] {
  --md-primary-fg-color: #111316;
  --md-primary-fg-color--light: #2a2e35;
  --md-primary-fg-color--dark: #000;
  --md-accent-fg-color: {{accent_hex}};
  --md-typeset-a-color: #c45a00;
}
[data-md-color-scheme="slate"] {
  --md-primary-fg-color: #16181c;
  --md-accent-fg-color: #ff8f26;
  --md-typeset-a-color: #ffa04d;
}
.md-header, .md-tabs { background-color: var(--md-primary-fg-color); }
.md-tabs__link--active, .md-tabs__link:hover { color: #ff9a3d; }
.md-typeset h1 { font-weight: 700; letter-spacing: -0.01em; }
.md-typeset h2 { border-bottom: 1px solid var(--md-default-fg-color--lightest); padding-bottom: .2em; }
/* wide reference tables scroll instead of squashing */
.md-typeset__table { min-width: 100%; }
.md-typeset table:not([class]) { font-size: .68rem; display: table; }
.md-typeset table:not([class]) td { vertical-align: top; }
.md-grid { max-width: 1440px; }
/* cards on the landing page */
.md-typeset .grid.cards > ul > li { border-radius: 10px; }
.status-pill { display:inline-block; padding:0 .45em; border-radius:999px; font-size:.7em; font-weight:600;
  background: var(--md-default-fg-color--lightest); }
.risk-high { color: #d32f2f; font-weight: 700; }
.risk-med { color: #ef6c00; font-weight: 700; }
.risk-low { color: #2e7d32; font-weight: 700; }
