/* Project styles. Loads after assets/site-theme.css (the skill's theme, refreshed on every build), so anything here wins.
   The accent comes from site.accent_hex in codebase-docs.json. */
:root, [data-md-color-scheme="default"] {
  --md-accent-fg-color: {{accent_hex}};
}
.md-grid { max-width: 1440px; }
/* wide reference tables scroll instead of squashing */
.md-typeset__table { min-width: 100%; }
.md-typeset table:not([class]) { display: table; }
.status-pill { display: inline-block; padding: 0 .4em; border-radius: .2rem; font-size: .7em; font-weight: 500;
  border: 1px solid var(--md-default-fg-color--lightest); }
/* risk words in tables: coloured text; low risk stays neutral (green is kept for "passed") */
.risk-high { color: #b42318; font-weight: 600; }
.risk-med { color: #a16207; font-weight: 600; }
.risk-low { color: var(--md-default-fg-color--light); font-weight: 600; }
[data-md-color-scheme="slate"] .risk-high { color: #ff7b6b; }
[data-md-color-scheme="slate"] .risk-med { color: #e3b44c; }
