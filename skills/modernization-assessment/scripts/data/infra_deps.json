{
 "_note": "Server types the skill looks for. packages = NuGet ids (anchored regex); code = line regex on .cs/.vb; config_keys = key names on config lines; config_values = value patterns; compose_image = image names in docker-compose / Dockerfile; server_roles = roles in server_roles.json that serve it. Add a type here and it appears in every output.",
 "types": [
  {
   "id": "sql-server",
   "label": "SQL Server",
   "kind": "database",
   "ports": [
    1433
   ],
   "packages": "^(System\\.Data\\.SqlClient|Microsoft\\.Data\\.SqlClient|Microsoft\\.EntityFrameworkCore\\.SqlServer|EntityFramework\\.SqlServer|Microsoft\\.SqlServer\\.Management\\.\\w+|Microsoft\\.SqlServer\\.Types|linq2db\\.SqlServer)$",
   "code": "\\b(SqlConnection|SqlCommand|SqlDataAdapter|UseSqlServer|SqlBulkCopy)\\b",
   "config_keys": "(?i)(connectionstring|sqlserver|sql_server|datasource|dbserver)",
   "config_values": "(?i)\\b(Data Source|Server)\\s*=",
   "compose_image": "(?i)mcr\\.microsoft\\.com/mssql|mssql/server",
   "server_roles": [
    "sql-server"
   ],
   "aws": "SQL Server on EC2 (same edition and version); later Amazon RDS or PostgreSQL",
   "lift_and_shift": "Databases stay on SQL Server on EC2: carry the server names, listener / availability group and linked servers."
  },
  {
