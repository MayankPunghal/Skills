   "config_keys": "(?i)(^|[\\\"'\\s:._-])redis([\\\"'\\s:._-]|$)",
   "config_values": "",
   "compose_image": "(?i)(^|/)redis(:|$)|redis/redis-stack|bitnami/redis",
   "server_roles": [
    "redis"
   ],
   "aws": "Amazon ElastiCache (Valkey / Redis) or Redis on EC2",
   "lift_and_shift": "Redis servers move as they are (or the same cluster on EC2): carry host names, ports and the password source."
  },
